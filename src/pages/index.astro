---
import * as packageInfo from "../../package.json";
import CruxApp from "../components/CruxApp.svelte";
import SavedQueries from "../components/SavedQueries.svelte";

let title = "🚀 CrUX Compare";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="stylesheet" href="/style/global.css" />
    </head>
    <body>
        <main>
            <header>
                <h1 class="logo">{title}</h1>

                <p>
                    Compare Chrome UX Report field data for multiple origins or
                    URLs
                </p>
            </header>
            <CruxApp client:visible />
            <SavedQueries client:visible />
            <footer>
                Crux Compare v.{packageInfo.version} - created by{" "}
                <a href="https://gotomi.info">gotomi.info</a> with data from the{" "}
                <a href="https://developer.chrome.com/docs/crux">
                    Chrome UX Report
                </a>
            </footer>
        </main>
    </body>
</html>
<style>
    header {
        padding: var(--padding);
        background-color: #1f1f1f;
        color: #fafafa;
        margin: 0;
    }
    footer {
        text-align: center;
        display: block;
        padding-bottom: 32px;
    }
    .logo {
        display: inline-block;
        margin: 0;
    }
</style>
