// Wrangler config consumed by the @astrojs/cloudflare adapter (v14) during
// `astro dev` / `astro build` (it cannot read cloudflare.config.ts yet).
// Keep in sync with cloudflare.config.ts, which the `cf` CLI reads for deploy
// and ignores this file once cloudflare.config.ts exists.
{
	"name": "crux-compare",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	}
}
